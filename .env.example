NVIDIA_API_KEY=
NVIDIA_TTS_API_KEY=
PORT=3000
# Optional ordered model routes; the key is only read by the server.
AI_IMPORT_MODELS=openai/gpt-oss-20b,nvidia/nemotron-3-super-120b-a12b
AI_REVIEW_MODELS=openai/gpt-oss-20b,nvidia/nemotron-3-super-120b-a12b
AI_CHAT_MODELS=openai/gpt-oss-20b,nvidia/nemotron-3-super-120b-a12b
# Optional shared limiter for Vercel or multiple server instances.
# Set both values in deployment environment to enforce one request every 15 seconds globally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
