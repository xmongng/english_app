NVIDIA_API_KEY=
NVIDIA_TTS_API_KEY=
PORT=3000
# Optional ordered model routes; the key is only read by the server.
AI_IMPORT_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,openai/gpt-oss-20b,nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3-ultra-550b-a55b
AI_REVIEW_MODELS=openai/gpt-oss-20b,nvidia/nemotron-3-super-120b-a12b
AI_CHAT_MODELS=openai/gpt-oss-20b,nvidia/nemotron-3-super-120b-a12b
# Optional Redis override. Connected private Vercel Blob provides the shared limiter by default.
# Without Redis or Blob, the limiter is local to one server process.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
